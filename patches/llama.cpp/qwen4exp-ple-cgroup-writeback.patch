+    def tensor_force_quant(self, name: str, new_name: str, bid: int | None, n_dims: int):
+        # In bounded conversion mode the 204.8 GB F32 PLE map must stream
+        # directly into GGUFWriter's temporary file. BF16.quantize() first
+        # materializes a 102.4 GB anonymous result (and grouped intermediates),
+        # which is enough to kill a 125 GiB cgroup before the writer sees it.
+        # Keeping only this transient tensor F32 avoids that allocation. The
+        # downstream release quantizer still applies the required, explicitly
+        # audited PLE override, so this does not select the release precision.
+        ple_name = gguf.TENSOR_NAMES[gguf.MODEL_TENSOR.PER_LAYER_TOKEN_EMBD]
+        if self.use_temp_file and new_name == ple_name + ".weight":
+            return gguf.GGMLQuantizationType.F32
+        return super().tensor_force_quant(name, new_name, bid, n_dims)
