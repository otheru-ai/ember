+        # when the host has enough page cache to postpone ordinary reclaim.
         from .base import LazyTorchTensor
 
         eager = LazyTorchTensor.to_eager(shard).to(torch.float32).contiguous()
         self._ple_map[start:start + rows] = eager.numpy()
         del eager
+        mapped = self._ple_map._mmap
+        if not hasattr(mapped, "madvise") or not hasattr(mmap, "MADV_DONTNEED"):
+            raise RuntimeError("bounded PLE conversion requires mmap MADV_DONTNEED")
+        byte_start = start * self._ple_row_dim * 4
+        byte_end = (start + rows) * self._ple_row_dim * 4
+        aligned_start = byte_start - byte_start % mmap.PAGESIZE
+        aligned_end = min(
+            len(mapped),
+            ((byte_end + mmap.PAGESIZE - 1) // mmap.PAGESIZE) * mmap.PAGESIZE,
+        )
+        length = aligned_end - aligned_start
+        mapped.flush(aligned_start, length)
+        mapped.madvise(mmap.MADV_DONTNEED, aligned_start, length)
 
