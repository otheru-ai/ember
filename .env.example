# The default is the pinned DeepSeek target/draft pair.
# EMBER_DEPLOYMENT_MODE=deepseek-v4-flash
# EMBER_AUTO_DOWNLOAD=1
# Verify pre-existing models once, then reuse identity-bound records from the
# persistent cache mount. Downloads and changed files are always re-verified.
# EMBER_VERIFY_EXISTING_SHA256=1
# Ember has no authentication. Use 0.0.0.0 only behind a trusted gateway.
# EMBER_HOST=127.0.0.1
# EMBER_PORT=8080
# EMBER_MODELS_DIR=./models
# EMBER_CACHE_DIR=./cache
# Optional CPU/GPU/NPU overlay (`compose.xdna.yaml`). The normal image ignores
# these. Two sessions are required to overlap NPU proposals and GPU verify.
# EMBER_XDNA_BATCH_SESSIONS=2
# DFLASH_DSPARK_XDNA_REQUIRED=0
# DFLASH_DSPARK_XDNA_GPU_MAIN=1
# DFLASH_DS4_SPEC_SHADOW_SUFFIX_ROWS=4
# DFLASH_DS4_TIMING=0
# Keep disabled: the measured fixtures did not support confidence admission.
# DFLASH_DS4_RESIDENT_MIN_CONFIDENCE_MILLI=0
# Override only to select another published image or immutable SHA tag.
# EMBER_IMAGE_REF=ghcr.io/otheru-ai/ember:2026.8.10
# EMBER_DRY_MULTIPLIER=0
# Optional agent-progress controls. Reporting defaults to 8 in the server;
# automatic recovery is behavior-changing and remains disabled by default.
# EMBER_TOOL_LOOP_REPORT=8
# EMBER_NO_PROGRESS_REPORT=8
# EMBER_AUTO_ANSWER_AFTER_LOOP=0
# Image metadata for locally built release candidates.
# EMBER_VERSION=dev
# EMBER_VCS_REF=unknown
