# Optional overrides. With exactly one target GGUF in ./models, no .env file is
# needed. Paths below are container paths, not host paths.
# EMBER_MODEL=/models/DeepSeek-V4-Flash.gguf
# EMBER_DRAFT_MODEL=/models/DeepSeek-V4-Flash-draft.gguf
# EMBER_AUTO_DOWNLOAD=1
# EMBER_MODEL_REPO=otheru/DeepSeek-V4-Flash-Strix-Halo-GGUF
# EMBER_MODEL_FILE=DeepSeek-V4-Flash-0731-Abliterated-ROCMFPx-Strix-Lean-2.58bpw.gguf
# Defaults below pin and verify the release-tested artifact. If you select a
# different model, set its revision, digest, and size too (or explicitly leave
# EMBER_MODEL_SHA256 empty to opt out of integrity verification).
# EMBER_MODEL_REVISION=f6e507774f7133568f6fec0635057cb20134f307
# EMBER_MODEL_SHA256=18aec8c0be4087007e557aa6020b28f12cd4c5d1f9c67b2a815c152aea97b3ed
# EMBER_MODEL_SIZE_BYTES=91547243104
# EMBER_PORT=8080
# EMBER_MODELS_DIR=./models
# EMBER_CACHE_DIR=./cache
# EMBER_DRY_MULTIPLIER=0
# Optional agent-progress controls. Reporting defaults to 8 in the server;
# automatic recovery is behavior-changing and remains disabled by default.
# EMBER_TOOL_LOOP_REPORT=8
# EMBER_NO_PROGRESS_REPORT=8
# EMBER_AUTO_ANSWER_AFTER_LOOP=0
# Image metadata for locally built release candidates.
# EMBER_VERSION=dev
# EMBER_VCS_REF=unknown
