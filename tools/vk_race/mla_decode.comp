#version 460
// MLA decode attention via VK_KHR_cooperative_matrix, for a head-to-head race
// against the hand-written WMMA kernel on gfx1151.
//
// Same algorithm as the HIP kernel: split-K over the KV span, all 64 query heads
// resident in one workgroup, online softmax, f16 inputs with f32 accumulation.
// RADV lowers coopMatMulAdd to the same v_wmma_f32_16x16x16_f16, so this
// measures RADV's lowering and layout choices against hand-written fragments.

#extension GL_KHR_cooperative_matrix          : require
#extension GL_KHR_memory_scope_semantics      : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage        : require
#extension GL_KHR_shader_subgroup_basic       : require
#extension GL_KHR_shader_subgroup_shuffle     : require

#define D      512
#define NHEAD  64
#define TR     16          // KV rows per tile == coopmat N
#define MT     (NHEAD/16)  // 4 M-tiles over heads
#define NT     (D/16)      // 32 N-tiles over head_dim
#define NSUB   4           // subgroups per workgroup (256 invocations / 64)
#define NEG_INF (-3.402823466e38)

layout(local_size_x = 256) in;

layout(constant_id = 0) const uint SPEC_UNUSED = 0;

layout(std430, binding = 0) readonly  buffer QBuf { float16_t q[]; };      // [NHEAD][D]
layout(std430, binding = 1) readonly  buffer KBuf { float16_t k[]; };      // [n_kv][D]
layout(std430, binding = 2) readonly  buffer MBuf { float16_t msk[]; };    // [n_kv]
layout(std430, binding = 3) writeonly buffer ABuf { float partial_acc[]; };// [split][NHEAD][D]
layout(std430, binding = 4) writeonly buffer MMBuf { float partial_m[]; };
layout(std430, binding = 5) writeonly buffer LLBuf { float partial_l[]; };

layout(push_constant) uniform PC { int n_kv; int n_split; float scale; } pc;

shared float  s_sc[NHEAD * TR];
shared float16_t s_p[NHEAD * TR];
shared float  s_m[NHEAD];
shared float  s_l[NHEAD];
shared float  s_a[NHEAD];
// coopmat1 exposes no element->(row,col) mapping, so a per-row rescale of the
// accumulator has to go through memory. One 16x16 tile of scratch per subgroup.
shared float  s_rs[NSUB * 16 * 16];

void main() {
    const uint split = gl_WorkGroupID.x;
    const uint tid   = gl_LocalInvocationID.x;
    const uint sub   = gl_SubgroupID;            // 0..3, one M-tile each

    const int rows_per_split = (pc.n_kv + pc.n_split - 1) / pc.n_split;
    const int r_begin = int(split) * rows_per_split;
    const int r_end   = min(pc.n_kv, r_begin + rows_per_split);

    // O accumulator: MT x (NT/NSUB) = 4 x 8 = 32 tiles per subgroup.
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[MT][NT / NSUB];
    for (int m = 0; m < MT; ++m)
        for (int n = 0; n < NT / NSUB; ++n)
            acc[m][n] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (uint i = tid; i < NHEAD; i += 256u) { s_m[i] = NEG_INF; s_l[i] = 0.0; }
    barrier();

    for (int r0 = r_begin; r0 < r_end; r0 += TR) {
        const int rows = min(TR, r_end - r0);

        // ── QK: S[16 heads][TR rows] = Q * K^T, one M-tile per subgroup ──
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> s_acc =
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
        for (int kk = 0; kk < D / 16; ++kk) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> A;
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B;
            // A = Q[sub*16 .. +16][kk*16 .. +16], row-major, stride D
            coopMatLoad(A, q, uint(sub) * 16u * uint(D) + uint(kk) * 16u, uint(D),
                        gl_CooperativeMatrixLayoutRowMajor);
            // B = K^T: load the K rows column-major to transpose in place
            coopMatLoad(B, k, uint(r0) * uint(D) + uint(kk) * 16u, uint(D),
                        gl_CooperativeMatrixLayoutColumnMajor);
            s_acc = coopMatMulAdd(A, B, s_acc);
        }
        coopMatStore(s_acc, s_sc, uint(sub) * 16u * uint(TR), uint(TR),
                     gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        // ── online softmax: 4 invocations per head ──
        {
            const uint sh = tid / 4u, ss = tid % 4u;
            float v[4];
            float tmax = NEG_INF;
            for (int t = 0; t < 4; ++t) {
                const int r = int(ss) * 4 + t;
                const float mv = (r < rows) ? float(msk[r0 + r]) : -1.0e30;
                v[t] = (mv > -1.0e20) ? s_sc[sh * TR + uint(r)] * pc.scale + mv : NEG_INF;
                tmax = max(tmax, v[t]);
            }
            tmax = max(tmax, subgroupShuffleXor(tmax, 1u));
            tmax = max(tmax, subgroupShuffleXor(tmax, 2u));
            const float m_old = s_m[sh];
            const float m_new = max(m_old, tmax);
            const float a = (m_old == NEG_INF) ? 0.0 : exp(m_old - m_new);
            float sum = 0.0;
            for (int t = 0; t < 4; ++t) {
                const float p = (v[t] == NEG_INF) ? 0.0 : exp(v[t] - m_new);
                s_p[sh * TR + ss * 4u + uint(t)] = float16_t(p);
                sum += p;
            }
            sum += subgroupShuffleXor(sum, 1u);
            sum += subgroupShuffleXor(sum, 2u);
            if (ss == 0u) { s_m[sh] = m_new; s_l[sh] = s_l[sh] * a + sum; s_a[sh] = a; }
        }
        barrier();

        // ── rescale O, then PV: O[64][512] += P[64][TR] * V[TR][512] ──
        for (int m = 0; m < MT; ++m) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> A;
            coopMatLoad(A, s_p, uint(m) * 16u * uint(TR), uint(TR),
                        gl_CooperativeMatrixLayoutRowMajor);
            for (int n = 0; n < NT / NSUB; ++n) {
                const uint ntile = uint(sub) * uint(NT / NSUB) + uint(n);
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B;
                coopMatLoad(B, k, uint(r0) * uint(D) + ntile * 16u, uint(D),
                            gl_CooperativeMatrixLayoutRowMajor);
                // per-row rescale via shared scratch (see s_rs comment)
                const uint base = uint(sub) * 256u;
                coopMatStore(acc[m][n], s_rs, base, 16u,
                             gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                for (uint e = gl_SubgroupInvocationID; e < 256u; e += gl_SubgroupSize)
                    s_rs[base + e] *= s_a[uint(m) * 16u + (e / 16u)];
                subgroupMemoryBarrierShared();
                coopMatLoad(acc[m][n], s_rs, base, 16u,
                            gl_CooperativeMatrixLayoutRowMajor);
                acc[m][n] = coopMatMulAdd(A, B, acc[m][n]);
            }
        }
        barrier();
    }

    for (int m = 0; m < MT; ++m)
        for (int n = 0; n < NT / NSUB; ++n) {
            const uint ntile = uint(sub) * uint(NT / NSUB) + uint(n);
            coopMatStore(acc[m][n],
                         partial_acc,
                         split * uint(NHEAD) * uint(D) + uint(m) * 16u * uint(D) + ntile * 16u,
                         uint(D), gl_CooperativeMatrixLayoutRowMajor);
        }
    if (tid < uint(NHEAD)) {
        partial_m[split * uint(NHEAD) + tid] = s_m[tid];
        partial_l[split * uint(NHEAD) + tid] = s_l[tid];
    }
}
